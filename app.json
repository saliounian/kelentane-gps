{
  "expo": {
    "name": "Kelentane GPS",
    "slug": "kelentane-gps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kelentane.gps"
    },
    "android": {
      "package": "com.kelentane.gps",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A5C42",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6F4",
          "dark": { "backgroundColor": "#101513" }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#0A5C42"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kelentane affiche votre position sur la carte pour vous situer par rapport à vos véhicules. Utilisée uniquement quand l'écran carte est ouvert — jamais en arrière-plan."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7b68b6e7-be73-4a0e-8aeb-c1498548ee28"
      }
    }
  }
}
